# ===== AlphaResearch web config template =====
# Copy to .env.local (gitignored) and fill in. NEVER commit real keys.

# Backend API base URL (FastAPI). Local dev default:
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Clerk auth (optional) ---
# Leave BOTH blank to run keyless dev mode (fixed "demo" user, no sign-in).
# Set both to require sign-in and send a verified token to the API.
# Get them from the Clerk dashboard (https://dashboard.clerk.com).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional Clerk route overrides (defaults shown):
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ===== Production template (web host) =====
# Uncomment + fill when deploying. NEXT_PUBLIC_* is inlined at build, so set
# these before building the frontend.
# NEXT_PUBLIC_API_URL=https://api.example.com   # deployed FastAPI API origin
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...  # enabling this requires sign-in
# CLERK_SECRET_KEY=sk_live_...
# Backend must also set ALPHA_CLERK_JWKS_URL + ALPHA_CLERK_ISSUER (see .env.example)
# and ALPHA_CORS_ALLOW_ORIGINS to this web app's origin.
