# ===== AlphaResearch local config (gitignored) =====
# Staged cloud bring-up — see the message from Claude for the 4 stages.


# --- Redis Cloud ---
ALPHA_REDIS_URL=redis://default:REDACTED@REDACTED:6379


# --- Dispatch backend ---
# Stage 1-2: keep "local" (depth-0 + experiments run in-process) to validate Redis Cloud + GCS.
# Stage 3:   flip to "modal" AFTER `modal deploy infra/modal_app.py`.
ALPHA_DISPATCH_BACKEND=modal


# --- Recursion guardrails ---
ALPHA_MAX_DEPTH=1
ALPHA_MAX_FANOUT=3
ALPHA_DEFAULT_BUDGET=100


# --- Agent model ---
ALPHA_MODEL=claude-sonnet-4-6


# --- Anthropic: needed only for the agent loop (Stage 4); smoke_infra does NOT need it ---
ANTHROPIC_API_KEY=sk-ant-REDACTED


# --- GCS artifacts (provisioned: bucket is public-read for the demo) ---
ALPHA_GCS_BUCKET=alpharesearch-500100-artifacts
GOOGLE_APPLICATION_CREDENTIALS=./gcs-sa-key.json
STORAGE_EMULATOR_HOST=



