# ===== AlphaResearch config template =====
# Copy to .env (gitignored) and fill in real values. NEVER put real secrets here —
# this file is committed. Real secrets live in .env (local) or in Secret Manager /
# Modal secrets (cloud). See docs/gcp-setup.md.

# --- Redis (state + event bus + queue + budget) ---
ALPHA_REDIS_URL=redis://localhost:6379/0

# --- Dispatch backend: local (in-process stub) | modal ---
ALPHA_DISPATCH_BACKEND=local

# --- Recursion guardrails ---
ALPHA_MAX_DEPTH=1
ALPHA_MAX_FANOUT=3
ALPHA_DEFAULT_BUDGET=100

# --- Agent model ---
ALPHA_MODEL=claude-sonnet-4-6

# --- Anthropic (agent containers; in cloud this comes from Secret Manager / Modal) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- GCS artifacts ---
ALPHA_GCS_BUCKET=
# Local dev: path to a service-account JSON key. Cloud: injected as base64 secret.
GOOGLE_APPLICATION_CREDENTIALS=./gcs-sa-key.json
# GOOGLE_APPLICATION_CREDENTIALS_B64=<base64 of the SA key JSON>
STORAGE_EMULATOR_HOST=

# --- Runner internal API (agents -> runner) ---
# Per-session ephemeral tokens are minted by the runner at spawn (SEV-4). The
# shared token below is a DEV-ONLY fallback, rejected unless the fallback flag is on.
ALPHA_INTERNAL_TOKEN=dev-internal-token
ALPHA_INTERNAL_TOKEN_FALLBACK=false
ALPHA_INTERNAL_RUNNER_URL=http://localhost:8080
ALPHA_RUNNER_ENABLED=true

# --- Modal (sub-agents) + per-session volume mount root ---
ALPHA_MODAL_APP_NAME=alpharesearch
ALPHA_VOLUME_ROOT=/mnt/alpha-volumes

# --- Cloud Run (main-agent job) ---
ALPHA_GCP_PROJECT=alpharesearch-500100
ALPHA_GCP_REGION=us-central1
ALPHA_MAIN_AGENT_JOB_NAME=alpha-main-agent

# --- Local dev backend (no Cloud Run/Modal) ---
# When true, the API plays a scripted research run + chat replies per session so
# the full web app works locally. Pair with ALPHA_RUNNER_ENABLED=false.
ALPHA_LOCAL_SIM=false

# --- Auth (optional Clerk verification on the public API) ---
# Set the JWKS URL to require verified Clerk JWTs (run `uv sync --extra auth` first).
# Find it at: https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
ALPHA_CLERK_JWKS_URL=
ALPHA_CLERK_ISSUER=
