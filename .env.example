# --- Redis (Redis Cloud in prod; local redis-stack via deploy/docker-compose.dev.yml) ---
ALPHA_REDIS_URL=redis://localhost:6379/0

# --- Dispatch backend: local (in-process stub, no cloud needed) | modal ---
ALPHA_DISPATCH_BACKEND=local

# --- Recursion guardrails (= compute-allocation v0) ---
ALPHA_MAX_DEPTH=1
ALPHA_MAX_FANOUT=3
ALPHA_DEFAULT_BUDGET=100

# --- Model the agent runs on ---
ALPHA_MODEL=claude-sonnet-4-6

# --- Anthropic (required to run agent-kind jobs) ---
ANTHROPIC_API_KEY=

# --- Artifact storage: GCS in prod; leave blank to use local ./.artifacts fallback ---
ALPHA_GCS_BUCKET=
STORAGE_EMULATOR_HOST=

# --- Modal (only when ALPHA_DISPATCH_BACKEND=modal) ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
